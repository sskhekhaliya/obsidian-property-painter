{
  "name": "obsidian-property-painter",
  "version": "1.0.0",
  "description": "Show image thumbnails side-by-side with note properties, apply custom color rules to metadata properties (e.g. shelf: to-read, read, currently-reading), and paint file names in File Explorer.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "properties",
    "metadata",
    "cover",
    "thumbnail",
    "styling",
    "file-explorer",
    "shelf",
    "colors"
  ],
  "author": {
    "name": "SSKhekhaliya",
    "url": "https://www.sskhekhaliya.in/"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.10",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "typescript": "^5.5.4"
  }
}
